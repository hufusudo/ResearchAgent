# OpenAI-compatible LLM configuration
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Embedding configuration: "openai" or "local_hash"
# When set to "openai", EMBEDDING_API_KEY and EMBEDDING_BASE_URL fall back to LLM_* if left empty.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval & workflow limits
MAX_PAPERS_PER_QUERY=10
TOP_K_PAPERS=8
MAX_ITERATIONS=2

# Storage paths
DATA_DIR=data
OUTPUT_DIR=outputs

# Academic retrieval sources (comma-separated: arxiv,openalex,semantic_scholar)
ACADEMIC_SOURCES=arxiv,openalex
# Optional: email for OpenAlex polite pool (higher rate limit, no API key required)
OPENALEX_EMAIL=
# Optional: Semantic Scholar API key (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=